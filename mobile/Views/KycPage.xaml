<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.KycPage" Title="KYC"><ScrollView><VerticalStackLayout Padding="20" Spacing="14"><Label Text="Identity verification" FontSize="28"/><Label Text="The backend already exposes KYC submission/status. BVN/NIN values are sent only over the authenticated API; the backend stores them encrypted/hashed." TextColor="{StaticResource TextSecondary}"/><Border BackgroundColor="White" Padding="16" Stroke="#E5E8EF"><Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape><Grid ColumnDefinitions="*,*"><VerticalStackLayout><Label Text="Status" TextColor="{StaticResource TextSecondary}"/><Label Text="{Binding Status}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Tier" TextColor="{StaticResource TextSecondary}"/><Label Text="{Binding Tier}"/></VerticalStackLayout></Grid></Border><Label Text="BVN"/><Entry Text="{Binding Bvn}" Keyboard="Numeric" MaxLength="11" Placeholder="11 digits"/><Label Text="NIN"/><Entry Text="{Binding Nin}" Keyboard="Numeric" MaxLength="11" Placeholder="11 digits"/><Label Text="Date of birth"/><DatePicker Date="{Binding DateOfBirth}"/><Label Text="This is a submission, not an automatic verification. Approval remains an administrative/backend action." TextColor="{StaticResource TextSecondary}" FontSize="12"/><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}"/><Label Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}" IsVisible="{Binding HasSuccess}"/><Button Text="Submit KYC" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}"/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/></VerticalStackLayout></ScrollView></ContentPage>
