<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.SettingsPage" Title="Settings"><ScrollView><VerticalStackLayout Padding="20" Spacing="14"><Label Text="Settings" FontSize="28"/><Border BackgroundColor="White" Padding="18" Stroke="#E5E8EF"><Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape><VerticalStackLayout Spacing="5"><Label Text="Profile" TextColor="{StaticResource TextSecondary}"/><Label Text="{Binding Fullname}" FontSize="21"/><Label Text="{Binding Email}"/><Label Text="{Binding Phone}" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout></Border><Button Text="Beneficiaries" Style="{StaticResource SecondaryButton}" Command="{Binding GoBeneficiariesCommand}"/><Button Text="KYC" Style="{StaticResource SecondaryButton}" Command="{Binding GoKycCommand}"/><Button Text="Notifications" Style="{StaticResource SecondaryButton}" Command="{Binding GoNotificationsCommand}"/><Label Text="Biometric login"/><Label Text="Planned for v2. SecureStorage is already used for session tokens; biometric gating is intentionally not implemented in v1." TextColor="{StaticResource TextSecondary}" FontSize="12"/><Button Text="Log out" BackgroundColor="#FDECEC" TextColor="{StaticResource Danger}" Command="{Binding LogoutCommand}"/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/></VerticalStackLayout></ScrollView></ContentPage>
