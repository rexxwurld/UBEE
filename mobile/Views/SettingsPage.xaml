<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.SettingsPage" Title="Me" Shell.NavBarIsVisible="False">
<ScrollView><VerticalStackLayout Spacing="0">
  <Border StrokeThickness="0" Padding="20,44,20,56"><Border.StrokeShape><RoundRectangle CornerRadius="0,0,28,28"/></Border.StrokeShape><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1A8FE3" Offset="0.0"/><GradientStop Color="#4FB8F5" Offset="1.0"/></LinearGradientBrush></Border.Background>
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
      <Border BackgroundColor="White" StrokeThickness="0" WidthRequest="60" HeightRequest="60"><Border.StrokeShape><RoundRectangle CornerRadius="30"/></Border.StrokeShape><Label Text="{Binding Initial}" TextColor="{StaticResource Primary}" FontSize="26" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center"/></Border>
      <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
        <Label Text="{Binding Fullname}" FontSize="20" FontFamily="OpenSansSemibold" TextColor="White"/>
        <Border BackgroundColor="#33FFFFFF" StrokeThickness="0" Padding="10,3" HorizontalOptions="Start"><Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape><Label Text="{Binding TierLabel}" TextColor="White" FontSize="12"/></Border>
      </VerticalStackLayout>
      <Label Grid.Column="2" Text="›" TextColor="White" FontSize="30" VerticalOptions="Center"/>
      <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoProfileCommand}"/></Grid.GestureRecognizers>
    </Grid>
  </Border>

  <VerticalStackLayout Padding="18,0,18,24" Spacing="14" Margin="0,-34,0,0">
    <Border Style="{StaticResource CardBorder}" Padding="10,18"><Grid ColumnDefinitions="*,*,*">
      <VerticalStackLayout Grid.Column="0" Spacing="8"><Border Style="{StaticResource IconTile}"><Image Source="ic_history.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/></Border><Label Text="Transactions" FontSize="12" HorizontalOptions="Center"/><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding GoTransactionsCommand}"/></VerticalStackLayout.GestureRecognizers></VerticalStackLayout>
      <VerticalStackLayout Grid.Column="1" Spacing="8"><Border Style="{StaticResource IconTile}"><Image Source="ic_gauge.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/></Border><Label Text="Account Limits" FontSize="12" HorizontalOptions="Center"/><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding GoKycCommand}"/></VerticalStackLayout.GestureRecognizers></VerticalStackLayout>
      <VerticalStackLayout Grid.Column="2" Spacing="8"><Border Style="{StaticResource IconTile}"><Image Source="ic_bell.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/></Border><Label Text="Notifications" FontSize="12" HorizontalOptions="Center"/><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding GoNotificationsCommand}"/></VerticalStackLayout.GestureRecognizers></VerticalStackLayout>
    </Grid></Border>

    <Border Style="{StaticResource CardBorder}" Padding="6,4"><VerticalStackLayout>
      <Grid Padding="12,15" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Image Source="ic_user.svg" WidthRequest="22" HeightRequest="22"/><Label Grid.Column="1" Text="My Profile" VerticalOptions="Center"/><Image Grid.Column="2" Source="ic_chevron.svg" WidthRequest="16" HeightRequest="16"/><Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoProfileCommand}"/></Grid.GestureRecognizers></Grid>
      <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="18,0"/>
      <Grid Padding="12,15" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Image Source="ic_users.svg" WidthRequest="22" HeightRequest="22"/><Label Grid.Column="1" Text="Favourites" VerticalOptions="Center"/><Image Grid.Column="2" Source="ic_chevron.svg" WidthRequest="16" HeightRequest="16"/><Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoBeneficiariesCommand}"/></Grid.GestureRecognizers></Grid>
      <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="18,0"/>
      <Grid Padding="12,15" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Image Source="ic_shield.svg" WidthRequest="22" HeightRequest="22"/><Label Grid.Column="1" Text="Verification (BVN &amp; NIN)" VerticalOptions="Center"/><Image Grid.Column="2" Source="ic_chevron.svg" WidthRequest="16" HeightRequest="16"/><Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoKycCommand}"/></Grid.GestureRecognizers></Grid>
    </VerticalStackLayout></Border>

    <Border Style="{StaticResource CardBorder}" BackgroundColor="{StaticResource SkyMist}">
      <VerticalStackLayout Spacing="4"><Label Text="Biometric login" FontFamily="OpenSansSemibold"/><Label Text="Planned for v2. SecureStorage is already used for session tokens; biometric gating is intentionally not implemented in v1." Style="{StaticResource Muted}" FontSize="12"/></VerticalStackLayout>
    </Border>
    <Button Text="Log out" BackgroundColor="#FDECEC" TextColor="{StaticResource Danger}" HeightRequest="52" Command="{Binding LogoutCommand}"/>
    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
  </VerticalStackLayout>
</VerticalStackLayout></ScrollView></ContentPage>
