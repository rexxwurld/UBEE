<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.WalletPage" Title="Wallet"><ScrollView><VerticalStackLayout Padding="20" Spacing="16"><Label Text="Wallet" FontSize="28"/><Border BackgroundColor="White" Padding="20" Stroke="#E5E8EF"><Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape><VerticalStackLayout><Label Text="Balance" TextColor="{StaticResource TextSecondary}"/><Label Text="{Binding DisplayBalance}" FontSize="32"/><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding AccountNumber}" TextColor="{StaticResource TextSecondary}"/><Button Grid.Column="1" Text="Copy" Style="{StaticResource SecondaryButton}" Command="{Binding CopyAccountCommand}"/></Grid></VerticalStackLayout></Border><Label Text="Deposit and withdrawal" FontSize="18"/><Label Text="Deposit and withdrawal actions are not exposed in the current customer API contract, so they are intentionally not simulated here." TextColor="{StaticResource TextSecondary}"/><Label Text="Wallet activity" FontSize="20"/><CollectionView ItemsSource="{Binding History}" EmptyView="No wallet activity yet."><CollectionView.ItemTemplate><DataTemplate><Grid Padding="0,12" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Direction}"/><Label Text="{Binding Description}" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Amount, StringFormat='₦{0:N2}'}"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/></VerticalStackLayout></ScrollView></ContentPage>
