<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.LoginPage" Title="Sign in" Shell.NavBarIsVisible="False" BackgroundColor="White">
<ScrollView><VerticalStackLayout Spacing="0">
<Border StrokeThickness="0" Padding="24,64,24,48"><Border.StrokeShape><RoundRectangle CornerRadius="0,0,32,32"/></Border.StrokeShape><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1A8FE3" Offset="0.0"/><GradientStop Color="#4FB8F5" Offset="1.0"/></LinearGradientBrush></Border.Background><VerticalStackLayout Spacing="4"><Label Text="U-BEE" FontSize="38" FontFamily="OpenSansSemibold" TextColor="White"/><Label Text="Secure banking, built for everyday life." TextColor="#D6EEFF"/></VerticalStackLayout></Border>
<VerticalStackLayout Padding="24,24,24,30" Spacing="12">
  <Label Text="Welcome back" Style="{StaticResource PageTitle}"/>
  <Label Text="Sign in with your phone number and PIN." Style="{StaticResource Muted}"/>
  <Label Text="Phone number" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
  <Border Style="{StaticResource FieldBorder}"><Entry Placeholder="080 1234 5678" Keyboard="Telephone" MaxLength="16" Text="{Binding Phone}"/></Border>
  <Label Text="PIN" Style="{StaticResource FieldLabel}"/>
  <Border Style="{StaticResource FieldBorder}"><Entry Placeholder="6-digit PIN" IsPassword="True" Keyboard="Numeric" MaxLength="6" Text="{Binding Pin}"/></Border>
  <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}"/>
  <Button Text="Login" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
  <Button Text="Forgot PIN?" Style="{StaticResource GhostButton}" Command="{Binding GoForgotCommand}"/>
  <BoxView HeightRequest="1" Color="{StaticResource Border}"/>
  <Button Text="Create an account" Style="{StaticResource SecondaryButton}" Command="{Binding GoRegisterCommand}"/>
  <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
</VerticalStackLayout></VerticalStackLayout></ScrollView></ContentPage>
