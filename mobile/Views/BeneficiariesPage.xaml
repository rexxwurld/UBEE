<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.BeneficiariesPage" Title="Beneficiaries"><ScrollView><VerticalStackLayout Padding="20" Spacing="14"><Label Text="Beneficiaries" FontSize="28"/><Label Text="Saved recipients are stored locally on this device because the current backend has no beneficiary endpoints." TextColor="{StaticResource TextSecondary}"/><Border BackgroundColor="White" Padding="16" Stroke="#E5E8EF"><Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape><VerticalStackLayout Spacing="10"><Entry Text="{Binding Name}" Placeholder="Name"/><Entry Text="{Binding AccountNumber}" Placeholder="Account number" Keyboard="Numeric"/><Entry Text="{Binding Bank}" Placeholder="Bank"/><Button Text="Save beneficiary" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"/></VerticalStackLayout></Border><Label Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}" IsVisible="{Binding HasSuccess}"/><CollectionView ItemsSource="{Binding Items}" EmptyView="No saved beneficiaries."><CollectionView.ItemTemplate><DataTemplate><Border BackgroundColor="White" Padding="14" Margin="0,5" Stroke="#E5E8EF"><Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}"/><Label Text="{Binding AccountNumber}"/><Label Text="{Binding Bank}" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout><Button Grid.Column="1" Text="Remove" BackgroundColor="Transparent" TextColor="{StaticResource Danger}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveCommand}" CommandParameter="{Binding .}"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></ScrollView></ContentPage>
