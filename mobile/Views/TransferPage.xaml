<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.TransferPage" Title="Send money"><ScrollView><VerticalStackLayout Padding="20" Spacing="14"><Label Text="Send money" FontSize="28"/><Label Text="Enter the recipient details. A confirmation step is required before the money-moving request is submitted." TextColor="{StaticResource TextSecondary}"/><Label Text="Recipient account number"/><Entry Text="{Binding AccountNumber}" Keyboard="Numeric" Placeholder="0123456789"/><Label Text="Bank"/><Entry Text="{Binding Bank}" Placeholder="Bank name"/><Label Text="Amount"/><Entry Text="{Binding Amount}" Keyboard="Numeric" Placeholder="0.00"/><Label Text="Description (optional)"/><Entry Text="{Binding Description}" Placeholder="What is this payment for?"/><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}"/><Button Text="Review transfer" Style="{StaticResource PrimaryButton}" Command="{Binding ReviewCommand}"/>
<Border IsVisible="{Binding ShowConfirmation}" BackgroundColor="White" Padding="18" Stroke="#E5E8EF"><Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape><VerticalStackLayout Spacing="10"><Label Text="Confirm transfer" FontSize="22"/><Label Text="Recipient"/><Label Text="{Binding AccountNumber}"/><Label Text="Bank"/><Label Text="{Binding Bank}"/><Label Text="Amount"/><Label Text="{Binding ConfirmAmount}" FontSize="25"/><Label Text="{Binding Description}" TextColor="{StaticResource TextSecondary}"/><Label Text="A new idempotency key will be generated for this submission attempt." FontSize="12" TextColor="{StaticResource TextSecondary}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelReviewCommand}"/><Button Grid.Column="1" Text="Confirm &amp; Send" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}" IsEnabled="{Binding Submitting, Converter={StaticResource InverseBoolConverter}}"/></Grid><ActivityIndicator IsRunning="{Binding Submitting}" IsVisible="{Binding Submitting}"/></VerticalStackLayout></Border><Label Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}" IsVisible="{Binding HasSuccess}"/></VerticalStackLayout></ScrollView></ContentPage>
