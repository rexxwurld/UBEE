<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.ForgotPasswordPage" Title="Forgot PIN" Shell.NavBarIsVisible="False" BackgroundColor="White">
<ScrollView><VerticalStackLayout Spacing="0">
<Border StrokeThickness="0" Padding="24,64,24,48"><Border.StrokeShape><RoundRectangle CornerRadius="0,0,32,32"/></Border.StrokeShape><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1A8FE3" Offset="0.0"/><GradientStop Color="#4FB8F5" Offset="1.0"/></LinearGradientBrush></Border.Background><VerticalStackLayout Spacing="4"><Label Text="U-BEE" FontSize="38" FontFamily="OpenSansSemibold" TextColor="White"/><Label Text="Secure banking, built for everyday life." TextColor="#D6EEFF"/></VerticalStackLayout></Border>
<VerticalStackLayout Padding="24,24,24,30" Spacing="12">
  <Label Text="Forgot PIN?" Style="{StaticResource PageTitle}"/>
  <Label Text="Enter your phone number and we will send you a one-time code to reset your PIN." Style="{StaticResource Muted}"/>
  <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Phone}" Placeholder="Phone number" Keyboard="Telephone" MaxLength="16"/></Border>
  <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}"/>
  <Button Text="Send OTP" Style="{StaticResource PrimaryButton}" Command="{Binding SendOtpCommand}"/>
  <Button Text="Back to login" Style="{StaticResource GhostButton}" Command="{Binding GoLoginCommand}"/>
</VerticalStackLayout></VerticalStackLayout></ScrollView></ContentPage>
