<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.ForgotPasswordPage" Title="Forgot password"><VerticalStackLayout Padding="24,70" Spacing="16"><Label Text="Forgot password?" FontSize="30"/><Label Text="The backend endpoint is reserved for the future password-recovery flow. Until it is implemented, this request will return the real server error rather than pretending success." TextColor="{StaticResource TextSecondary}"/><Entry Text="{Binding Email}" Placeholder="Email address" Keyboard="Email"/><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}"/><Button Text="Send OTP" Style="{StaticResource PrimaryButton}" Command="{Binding SendOtpCommand}"/><Button Text="Back to login" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Command="{Binding GoLoginCommand}"/></VerticalStackLayout></ContentPage>
