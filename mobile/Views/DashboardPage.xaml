<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.DashboardPage" Title="U-BEE"><ScrollView><VerticalStackLayout Padding="20,18" Spacing="18"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Good day" TextColor="{StaticResource TextSecondary}"/><Label Text="{Binding Fullname}" FontSize="25"/></VerticalStackLayout><Button Text="🔔" BackgroundColor="Transparent" Command="{Binding GoNotificationsCommand}"/></Grid>
<Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" Padding="22"><Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape><VerticalStackLayout Spacing="7"><Label Text="Available balance" TextColor="#DCE7FF"/><Label Text="{Binding DisplayBalance}" FontSize="34" TextColor="White"/><Label Text="Account number" TextColor="#DCE7FF"/><Label Text="{Binding AccountNumber}" TextColor="White" FontSize="16"/><Button Text="Show / hide balance" BackgroundColor="#FFFFFF22" TextColor="White" Command="{Binding ToggleBalanceCommand}"/></VerticalStackLayout></Border>
<Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><Button Text="Send" Style="{StaticResource PrimaryButton}" Command="{Binding GoTransferCommand}"/><Button Grid.Column="1" Text="Wallet" Style="{StaticResource SecondaryButton}" Command="{Binding GoWalletCommand}"/><Button Grid.Column="2" Text="History" Style="{StaticResource SecondaryButton}" Command="{Binding GoTransactionsCommand}"/></Grid>
<Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12"><Button Text="Beneficiaries" Style="{StaticResource SecondaryButton}" Command="{Binding GoBeneficiariesCommand}"/><Button Grid.Column="1" Text="KYC" Style="{StaticResource SecondaryButton}" Command="{Binding GoKycCommand}"/><Button Grid.Row="1" Text="Notifications" Style="{StaticResource SecondaryButton}" Command="{Binding GoNotificationsCommand}"/><Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" Padding="16" Stroke="#E5E8EF"><Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape><VerticalStackLayout><Label Text="KYC status" TextColor="{StaticResource TextSecondary}"/><Label Text="{Binding KycStatus}" FontSize="18"/></VerticalStackLayout></Border></Grid>
<Label Text="Recent activity" FontSize="20"/><CollectionView ItemsSource="{Binding RecentTransactions}" EmptyView="No recent transactions."><CollectionView.ItemTemplate><DataTemplate><Grid Padding="0,12" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Description, StringFormat='{}{0}'}"/><Label Text="{Binding Status}" TextColor="{StaticResource TextSecondary}" FontSize="12"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Amount, StringFormat='₦{0:N2}'}"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/></VerticalStackLayout></ScrollView></ContentPage>
