<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.RegisterPage" Title="Create account">
<ScrollView><VerticalStackLayout Padding="24,40" Spacing="14"><Label Text="Create your U-BEE account" FontSize="28"/><Label Text="Use your real account details. Your password is never stored in the app." TextColor="{StaticResource TextSecondary}"/>
<Label Text="Full name"/><Entry Text="{Binding Fullname}" Placeholder="John Doe"/><Label Text="Email"/><Entry Text="{Binding Email}" Keyboard="Email" Placeholder="you@example.com"/><Label Text="Phone"/><Entry Text="{Binding Phone}" Keyboard="Telephone" Placeholder="080..."/><Label Text="Password"/><Entry Text="{Binding Password}" IsPassword="True"/><Label Text="Confirm password"/><Entry Text="{Binding ConfirmPassword}" IsPassword="True"/>
<Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}"/><Label Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}" IsVisible="{Binding HasSuccess}"/><Button Text="Create account" Style="{StaticResource PrimaryButton}" Command="{Binding RegisterCommand}"/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/><Button Text="Already have an account? Sign in" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Command="{Binding GoLoginCommand}"/></VerticalStackLayout></ScrollView></ContentPage>
