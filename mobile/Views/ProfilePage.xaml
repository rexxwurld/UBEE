<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.ProfilePage" Title="My Profile">
<ScrollView><VerticalStackLayout Padding="18,16,18,24" Spacing="14">
  <Border Style="{StaticResource CardBorder}" Padding="0,24,0,8">
    <VerticalStackLayout Spacing="6">
      <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" WidthRequest="84" HeightRequest="84" HorizontalOptions="Center"><Border.StrokeShape><RoundRectangle CornerRadius="42"/></Border.StrokeShape><Label Text="{Binding Initial}" TextColor="White" FontSize="36" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center"/></Border>
      <Label Text="{Binding Fullname}" FontFamily="OpenSansSemibold" FontSize="17" HorizontalOptions="Center" Margin="0,4,0,12"/>
      <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="18,0"/>
      <Grid Padding="18,15" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><Label Text="U-BEE Account Number" FontFamily="OpenSansSemibold" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding AccountNumber}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/><Image Grid.Column="2" Source="ic_copy.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"><Image.GestureRecognizers><TapGestureRecognizer Command="{Binding CopyAccountCommand}"/></Image.GestureRecognizers></Image></Grid>
      <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="18,0"/>
      <Grid Padding="18,15" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><Label Text="Account Tier" FontFamily="OpenSansSemibold" VerticalOptions="Center"/><Border Grid.Column="1" BackgroundColor="{StaticResource SkyLight}" StrokeThickness="0" Padding="10,3" VerticalOptions="Center"><Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape><Label Text="{Binding TierLabel}" TextColor="{StaticResource PrimaryDark}" FontSize="13"/></Border><Image Grid.Column="2" Source="ic_chevron.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/><Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoLimitsCommand}"/></Grid.GestureRecognizers></Grid>
    </VerticalStackLayout>
  </Border>
  <Label Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}" IsVisible="{Binding HasSuccess}"/>
  <Border Style="{StaticResource CardBorder}" Padding="0,4">
    <VerticalStackLayout>
      <Grid Padding="18,15" ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label Text="Full Name" FontFamily="OpenSansSemibold" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding Fullname}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" HorizontalTextAlignment="End"/></Grid>
      <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="18,0"/>
      <Grid Padding="18,15" ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label Text="Mobile Number" FontFamily="OpenSansSemibold" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding PhoneDisplay}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" HorizontalTextAlignment="End"/></Grid>
      <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="18,0"/>
      <Grid Padding="18,15" ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label Text="Email" FontFamily="OpenSansSemibold" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding EmailMasked}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" HorizontalTextAlignment="End"/></Grid>
      <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="18,0"/>
      <Grid Padding="18,15" ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label Text="Date of Birth" FontFamily="OpenSansSemibold" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding DobDisplay}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" HorizontalTextAlignment="End"/></Grid>
      <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="18,0"/>
      <Grid Padding="18,15" ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label Text="Verification" FontFamily="OpenSansSemibold" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding KycStatusText}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" HorizontalTextAlignment="End"/></Grid>
    </VerticalStackLayout>
  </Border>
  <Label Text="Your phone number is your account number and your login ID." Style="{StaticResource Muted}" HorizontalTextAlignment="Center"/>
</VerticalStackLayout></ScrollView></ContentPage>
