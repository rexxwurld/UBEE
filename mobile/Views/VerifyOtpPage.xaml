<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.VerifyOtpPage" Title="Verify OTP"><VerticalStackLayout Padding="24,70" Spacing="16"><Label Text="Verify OTP" FontSize="30"/><Label Text="Enter the six-digit code. This screen supports the existing MFA login endpoint." TextColor="{StaticResource TextSecondary}"/><Entry Text="{Binding Otp}" Placeholder="123456" Keyboard="Numeric" MaxLength="6"/><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}"/><Label Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}" IsVisible="{Binding HasSuccess}"/><Button Text="Verify" Style="{StaticResource PrimaryButton}" Command="{Binding VerifyCommand}"/><Button Text="Resend OTP" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Command="{Binding ResendCommand}"/><Button Text="Back to login" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" Command="{Binding GoLoginCommand}"/></VerticalStackLayout></ContentPage>
