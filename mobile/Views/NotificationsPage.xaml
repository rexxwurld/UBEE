<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.NotificationsPage" Title="Notifications">
<VerticalStackLayout Padding="18,60" Spacing="14">
  <Border Style="{StaticResource CardBorder}" Padding="24">
    <VerticalStackLayout Spacing="10">
      <Border Style="{StaticResource IconTile}" WidthRequest="72" HeightRequest="72"><Border.StrokeShape><RoundRectangle CornerRadius="36"/></Border.StrokeShape><Label Text="🔔" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center"/></Border>
      <Label Text="No notifications" FontSize="19" FontFamily="OpenSansSemibold" HorizontalOptions="Center"/>
      <Label Text="The current backend does not expose notification endpoints. This screen intentionally shows an empty state rather than fake notifications." Style="{StaticResource Muted}" HorizontalTextAlignment="Center"/>
    </VerticalStackLayout>
  </Border>
</VerticalStackLayout></ContentPage>
