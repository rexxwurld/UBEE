<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.ResetPasswordPage" Title="Reset PIN" Shell.NavBarIsVisible="False" BackgroundColor="White">
<ScrollView><VerticalStackLayout Spacing="0">
<Border StrokeThickness="0" Padding="24,64,24,48"><Border.StrokeShape><RoundRectangle CornerRadius="0,0,32,32"/></Border.StrokeShape><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1A8FE3" Offset="0.0"/><GradientStop Color="#4FB8F5" Offset="1.0"/></LinearGradientBrush></Border.Background><VerticalStackLayout Spacing="4"><Label Text="U-BEE" FontSize="38" FontFamily="OpenSansSemibold" TextColor="White"/><Label Text="Secure banking, built for everyday life." TextColor="#D6EEFF"/></VerticalStackLayout></Border>
<VerticalStackLayout Padding="24,24,24,30" Spacing="12">
  <Label Text="Reset PIN" Style="{StaticResource PageTitle}"/>
  <Label Text="{Binding Phone, StringFormat='Enter the code sent to {0}'}" Style="{StaticResource Muted}"/>
  <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Otp}" Placeholder="6-digit code" Keyboard="Numeric" MaxLength="6"/></Border>
  <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding NewPin}" Placeholder="New 6-digit PIN" IsPassword="True" Keyboard="Numeric" MaxLength="6"/></Border>
  <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding ConfirmPin}" Placeholder="Confirm PIN" IsPassword="True" Keyboard="Numeric" MaxLength="6"/></Border>
  <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}"/>
  <Label Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}" IsVisible="{Binding HasSuccess}"/>
  <Button Text="Reset PIN" Style="{StaticResource PrimaryButton}" Command="{Binding ResetCommand}"/>
  <Button Text="Back to login" Style="{StaticResource GhostButton}" Command="{Binding GoLoginCommand}"/>
</VerticalStackLayout></VerticalStackLayout></ScrollView></ContentPage>
