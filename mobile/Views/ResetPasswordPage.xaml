<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UBee.App.Views.ResetPasswordPage" Title="Reset password"><VerticalStackLayout Padding="24,70" Spacing="16"><Label Text="Reset password" FontSize="30"/><Label Text="{Binding Email, StringFormat='Enter the code sent to {0}'}" TextColor="{StaticResource TextSecondary}"/><Entry Text="{Binding Otp}" Placeholder="6-digit code" Keyboard="Numeric" MaxLength="6"/><Entry Text="{Binding NewPassword}" Placeholder="New password" IsPassword="True"/><Entry Text="{Binding ConfirmPassword}" Placeholder="Confirm password" IsPassword="True"/><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}"/><Label Text="{Binding SuccessMessage}" TextColor="{StaticResource Success}" IsVisible="{Binding HasSuccess}"/><Button Text="Reset password" Style="{StaticResource PrimaryButton}" Command="{Binding ResetCommand}"/><Button Text="Back to login" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Command="{Binding GoLoginCommand}"/></VerticalStackLayout></ContentPage>
