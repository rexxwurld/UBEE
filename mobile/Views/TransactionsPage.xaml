<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:UBee.App.Views" x:Class="UBee.App.Views.TransactionsPage" Title="Transactions"><Grid RowDefinitions="Auto,Auto,*"><VerticalStackLayout Padding="20,18,20,8"><Label Text="Transactions" FontSize="28"/><Label Text="History is loaded incrementally. The current backend supports cursor pagination; the client can fall back to full-list behavior as the API evolves." TextColor="{StaticResource TextSecondary}" FontSize="12"/></VerticalStackLayout><Grid Grid.Row="1" Padding="20,8" ColumnDefinitions="*,*" ColumnSpacing="10"><Picker Title="Type" ItemsSource="{Binding Source={x:Static local:TransactionFilters.Types}}" SelectedItem="{Binding TypeFilter}"/><Picker Grid.Column="1" Title="Status" ItemsSource="{Binding Source={x:Static local:TransactionFilters.Statuses}}" SelectedItem="{Binding StatusFilter}"/></Grid><CollectionView Grid.Row="2" ItemsSource="{Binding FilteredTransactions}" RemainingItemsThreshold="3" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}" EmptyView="No transactions yet."><CollectionView.ItemTemplate><DataTemplate><Border BackgroundColor="White" Padding="15" Margin="20,5" Stroke="#E5E8EF"><Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Type}"/><Label Text="{Binding Description}" TextColor="{StaticResource TextSecondary}"/><Label Text="{Binding CreatedAt, StringFormat='{}{0:dd MMM yyyy, HH:mm}'}" FontSize="11" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1" HorizontalOptions="End"><Label Text="{Binding Amount, StringFormat='₦{0:N2}'}"/><Label Text="{Binding Status}" FontSize="11" HorizontalOptions="End"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></ContentPage>
