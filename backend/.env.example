# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core ---
PORT=4000
MONGO_URI=mongodb://localhost:27017/rexxpay
# Must be a REPLICA SET, not a standalone MongoDB - this codebase relies
# on multi-document transactions (mongoose sessions) everywhere money
# moves, and standalone MongoDB does not support them.
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=development
ADMIN_KEY=replace-with-a-long-random-string

# --- Admin RBAC (Phase 4) ---
# Separate secret from JWT_SECRET on purpose - see requireAdminAuth.js.
ADMIN_JWT_SECRET=replace-with-a-different-long-random-string
# Set to true once real AdminUser accounts are onboarded, to fully
# retire the legacy shared x-admin-key for ordinary requests.
DISABLE_LEGACY_ADMIN_KEY=false
# Set to true once you're using the maker-checker approval flow for
# adjustments (src/modules/approval/), to stop accepting direct calls
# to POST /api/v1/admin/adjustments entirely.
REQUIRE_MAKER_CHECKER=false

# --- Rate limiting (Phase 4) ---
TRUST_PROXY=1
GLOBAL_RATE_LIMIT=120
AUTH_RATE_LIMIT=10
ADMIN_RATE_LIMIT=30

# --- MFA / OTP (Phase 4) ---
# OTP delivery is a STUB in non-production (code is only logged to the
# console) and THROWS in production - see
# src/modules/otp/otp.service.js:deliverOtp. Do not let real users
# enable MFA until a real SMS/email provider is wired in there.
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5

# --- Field-level encryption (Phase 3 - KYC) ---
# Required before anyone can submit BVN/NIN via POST /api/v1/kyc/submit -
# fieldEncryption.js throws loudly at call-time if this is unset, rather
# than silently storing anything in plaintext.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=

# --- Legacy SwiftPay webhook config (Phase 3a - multi-partner) ---
# Used ONLY to seed the initial "swiftpay" Partner record on first
# startup (see server.js / partner.service.js:ensurePartnerFromEnv).
# Once that Partner record exists, these env vars are no longer read for
# routing/signing - the Partner record's own webhookUrl/webhookSecret
# take over. Kept here so an existing deployment upgrades transparently
# without a manual onboarding step for the partner it already had.
SWIFTPAY_WEBHOOK_SECRET=replace-with-a-long-random-string
SWIFTPAY_WEBHOOK_URL=https://your-swiftpay-instance.example.com/api/webhooks/bank

# --- Bank-rail provider (Phase 5 prep) ---
# See src/providers/ - "mock" (default) has no real bank connection at
# all. Set this once you've implemented and registered a real provider
# adapter (src/providers/index.js) for your actual banking rail/NIBSS
# connection/aggregator.
BANK_PROVIDER=mock

# --- Bearer/refresh tokens (Phase 10 - mobile/MAUI readiness) ---
# See src/modules/session/. Access tokens are short-lived (15 min,
# hardcoded) JWTs signed with JWT_SECRET; refresh tokens are long-lived
# opaque tokens tracked in the database (one row per device/session).
REFRESH_TOKEN_TTL_MS=2592000000

# --- Push notifications (Phase 10 prep) ---
# See src/notifications/ - same pluggable-provider pattern as
# BANK_PROVIDER above. "mock" just logs to console - no real FCM/APNs/
# web-push credential connected.
NOTIFICATION_PROVIDER=mock

# --- Stuck-transfer recovery job (Phase 2) ---
# Off by default - see src/jobs/recoverStuckTransfers.job.js for why.
RUN_RECOVERY_JOB=false
STUCK_TRANSFER_THRESHOLD_MS=600000
RECOVERY_JOB_INTERVAL_MS=300000

# --- Automated reconciliation (Phase 6) ---
# Off by default - see src/jobs/reconciliation.job.js. Compares
# ledger-derived balances against cached Wallet.balance/
# SettlementPool.poolBalance on an interval, opening/auto-resolving
# entries in the reconciliation exception queue
# (GET /api/v1/admin/reconciliation/exceptions).
RUN_RECONCILIATION_JOB=false
RECONCILIATION_JOB_INTERVAL_MS=3600000

# --- Partner secret rotation grace window (Phase 3a) ---
PARTNER_SECRET_ROTATION_GRACE_MS=86400000

# --- Transfer limits (Phase 3 - now tiered by KYC level) ---
# See src/config/limits.js's caveat: these defaults are illustrative,
# not verified-current CBN figures - confirm against the latest CBN
# circular before relying on them.
TIER1_MAX_SINGLE_TRANSFER=50000
TIER1_MAX_DAILY_OUTBOUND=50000
TIER1_MAX_BALANCE=300000
TIER2_MAX_SINGLE_TRANSFER=200000
TIER2_MAX_DAILY_OUTBOUND=500000
TIER2_MAX_BALANCE=500000
TIER3_MAX_SINGLE_TRANSFER=5000000
TIER3_MAX_DAILY_OUTBOUND=5000000
